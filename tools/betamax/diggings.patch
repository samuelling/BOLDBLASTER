+    for (const k of P.cells) { const i = k % DG.nx, j = (k / DG.nx) | 0; for (let a = 1; a <= 2; a++) for (let b = 1; b <= 2; b++) this.carved[(4 * j + b) * SX + 4 * i + a] = 1; }
