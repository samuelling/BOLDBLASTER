+  // cave-in candidates: links that lie on a loop (cutting one never strands any part of the warren)
+  const loopEdges = [...edges].filter((e) => { const [a, b] = e.split(':').map(Number); return !isBridge(adj, a, b); });
+  // figures in the gloom: a small pool, placed in the corridors ahead of you as you go (see update)
+  const figures = [0, 1, 2, 3].map((n) => ({ id: -1, k: n, cell: -1, foe: false, x: 0, z: 0, yaw: 0 }));
+  return { cells, edges: [...edges], adj, hatches, crates, loopEdges, figures, zone, seed };
+}
+
+function bfs(adj, src) {
+  const d = new Map([...adj.keys()].map((k) => [k, 1e9])); const q = [...src]; for (const s of src) d.set(s, 0);
+  while (q.length) { const a = q.shift(); for (const b of adj.get(a)) if (d.get(b) > d.get(a) + 1) { d.set(b, d.get(a) + 1); q.push(b); } }
+  return d;
+}
+function isBridge(adj, a, b) {   // is b unreachable from a without the a-b link?
+  const seen = new Set([a]), q = [a];
+  while (q.length) { const x = q.pop(); for (const y of adj.get(x)) { if ((x === a && y === b) || (x === b && y === a)) continue; if (y === b) return false; if (!seen.has(y)) { seen.add(y); q.push(y); } } }
