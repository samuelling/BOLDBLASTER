+  // hatches: on the lot, and on the dune crest (by the fighting positions) and its back
+  const want = [[-36, -116, 'lot'], [36, -116, 'lot'], [-36, -80, 'lot'], [36, -80, 'lot'], [-12, -98, 'lot'],
+    [-66, -50, 'line'], [-30, -50, 'line'], [30, -50, 'line'], [66, -50, 'line'], [-48, -62, 'back'], [48, -62, 'back']];
+  const hatches = [];
+  for (const [x, z, kind] of want) {
+    let bk = -1, bd = 1e9;
+    for (const k of cells) { const d = Math.hypot(cx(k % DG.nx) - x, cz((k / DG.nx) | 0) - z); if (d < bd) { bd = d; bk = k; } }
