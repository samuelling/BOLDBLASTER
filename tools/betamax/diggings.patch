+// The Diggings: dug-out tunnels and bunkers under the parking lot and the back of the dunes.
+// Hatches on the lot and along the dune crest drop down ladder shafts into a braided warren of
+// timber-shored corridors (several routes to most places), with magazine rooms holding ammunition
+// for the gun line. Things go wrong down there: shelling caves in a corridor (your mental map of
+// the place is now stale), a hit on the generator puts a sector's lights out (find your way back
+// to the ladder by lantern light), and figures stand in the gloom: your own wounded, or Texan
+// sappers who got in. One flat floor, below the ground everywhere it runs; all of it pure
+// geometry on a 1.5 m grid, so the player, the bot and the analysis share exactly the same walls.
+import * as THREE from 'three';
+import { heightAt } from './terrain.js';
+import { mulberry32 } from './rng.js';
+
+export const DG = { yf: 0.2, h: 2.75, cell: 6, sub: 1.5, x0: -84, z0: -122, nx: 29, nz: 13 };
+const SPC = 4;                                  // subcells per cell side
+const SX = DG.nx * SPC, SZ = DG.nz * SPC;
+const AX0 = DG.x0 - DG.cell / 2, AZ0 = DG.z0 - DG.cell / 2;   // world x/z of subcell (0,0)'s corner
+
+const cx = (i) => DG.x0 + i * DG.cell, cz = (j) => DG.z0 + j * DG.cell;
+const cid = (i, j) => j * DG.nx + i;
+
+function allowedCell(i, j) {
+  const x = cx(i), z = cz(j);
+  if (z <= -74) return Math.abs(x) <= 42;                 // under the parking lot
+  if (z === -68) return x === -36 || x === 0 || x === 36;   // three connecting drifts north under the lot's edge
+  return Math.abs(x) <= 78;                                // galleries behind the dune crest
+}
+
+export function buildPlan(seed = 1944) {
+  const r = mulberry32(seed);
+  const ok = new Uint8Array(DG.nx * DG.nz);
+  for (let j = 0; j < DG.nz; j++) for (let i = 0; i < DG.nx; i++) {
+    if (!allowedCell(i, j)) continue;
+    // keep at least 0.5 m of ground over the ceiling everywhere this cell's corridors run
+    let mn = 1e9;
+    for (let a = -3; a <= 3; a += 1.5) for (let b = -3; b <= 3; b += 1.5) mn = Math.min(mn, heightAt(cx(i) + a, cz(j) + b));
+    if (mn >= DG.yf + DG.h + 0.5) ok[cid(i, j)] = 1;
+  }
+  // keep the largest connected group of usable cells
+  const comp = new Int32Array(DG.nx * DG.nz).fill(-1); let best = -1, bestN = 0;
+  const nb = (k) => { const i = k % DG.nx, j = (k / DG.nx) | 0, o = []; if (i > 0) o.push(k - 1); if (i < DG.nx - 1) o.push(k + 1); if (j > 0) o.push(k - DG.nx); if (j < DG.nz - 1) o.push(k + DG.nx); return o.filter((q) => ok[q]); };
+  for (let k = 0, c = 0; k < ok.length; k++) {
+    if (!ok[k] || comp[k] >= 0) continue;
+    const st = [k]; comp[k] = c; let n = 0;
+    while (st.length) { const q = st.pop(); n++; for (const w of nb(q)) if (comp[w] < 0) { comp[w] = c; st.push(w); } }
+    if (n > bestN) { bestN = n; best = c; } c++;
+  }
+  for (let k = 0; k < ok.length; k++) if (comp[k] !== best) ok[k] = 0;
+  // braided maze: a random spanning tree, then extra links so most places have more than one way in
+  const edges = new Set(), key = (a, b) => (a < b ? a + ':' + b : b + ':' + a);
+  const seen = new Uint8Array(ok.length); const start = ok.indexOf(1); const st = [start]; seen[start] = 1;
+  while (st.length) {
+    const q = st[st.length - 1]; const opts = nb(q).filter((w) => !seen[w]);
+    if (!opts.length) { st.pop(); continue; }
+    const w = opts[Math.floor(r() * opts.length)]; edges.add(key(q, w)); seen[w] = 1; st.push(w);
+  }
+  for (let k = 0; k < ok.length; k++) if (ok[k]) for (const w of nb(k)) if (w > k && !edges.has(key(k, w)) && r() < 0.3) edges.add(key(k, w));
