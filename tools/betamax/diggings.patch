+  cellAt(x, z) { const i = Math.round((x - DG.x0) / DG.cell), j = Math.round((z - DG.z0) / DG.cell); if (i < 0 || j < 0 || i >= DG.nx || j >= DG.nz) return -1; const k = cid(i, j); return this.P.adj.has(k) ? k : -1; }
